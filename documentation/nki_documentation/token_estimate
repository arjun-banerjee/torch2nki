import requests
from bs4 import BeautifulSoup
import tiktoken

# Base URL of the documentation
BASE_URL = "https://awsdocs-neuron.readthedocs-hosted.com/en/latest/general/nki/api/nki.html"

# Initialize tokenizer
tokenizer = tiktoken.get_encoding("cl100k_base")

def get_sublinks(base_url):
    """Extract all sublinks from the documentation main page."""
    response = requests.get(base_url)
    soup = BeautifulSoup(response.text, 'html.parser')
    sublinks = set()
    
    for link in soup.find_all('a', href=True):
        href = link['href']
        if href.startswith("http"):  # Absolute link
            sublinks.add(href)
        elif href.startswith("/"):  # Relative link
            sublinks.add(base_url.rsplit('/', 1)[0] + href)
    
    return list(sublinks)

def get_text(url):
    """Fetch and extract visible text from a page."""
    response = requests.get(url)
    soup = BeautifulSoup(response.text, 'html.parser')
    return ' '.join(soup.stripped_strings)  # Extract only visible text

# Collect all sublinks
sublinks = get_sublinks(BASE_URL)

# Fetch text from all pages and store in a file
with open("nki_docs.txt", "w", encoding="utf-8") as f:
    total_tokens = 0
    for link in sublinks:
        text = get_text(link)
        tokens = len(tokenizer.encode(text))
        total_tokens += tokens
        f.write(f"## {link}\n\n{text}\n\n")
        print(f"{link}: {tokens} tokens")

print(f"\nTotal NKI documentation tokens: {total_tokens}")
